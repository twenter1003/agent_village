{
  "name": "subagent-tycoon",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm tokens && pnpm assets && concurrently -n server,web \"pnpm --filter @tycoon/server dev\" \"pnpm --filter @tycoon/web dev\"",
    "tokens": "tsx tools/gen-tokens.ts",
    "test": "pnpm tokens && pnpm assets && vitest run",
    "e2e": "playwright test",
    "lint": "tsc -b && eslint . && prettier --check .",
    "assets": "tsx tools/extract-assets.ts",
    "replay": "tsx tools/replay.ts",
    "connect": "tsx tools/connect.ts",
    "guide": "tsx tools/guide-pdf.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
