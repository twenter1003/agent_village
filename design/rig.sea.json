  "fx": {
    "shadowLift": {
      "$comment": "몸이 뜬 만큼 그림자를 줄인다. lift = 현재 프레임 body dy (뜨면 음수)",
      "rx": "38 + lift * 0.45",
      "ry": "9 + lift * 0.12"
    },
    "bubbles": {
      "$comment": "캐릭터 거품 층. 파츠가 아니라 별도 층(data-fx=bubbles)이고 150ms 전역 틱을 쓴다. 마을에서는 말하는 팀원과 seaWalkHelmet만 켠다.",
      "count": 3,
      "lifeTicks": 26,
      "phaseStep": 9,
      "t": "(tick + i * phaseStep) % lifeTicks",
      "radius": "2.2 + (i % 3) * 0.9 + t * 0.05",
      "opacity": "0.95 * (t < 3 ? t / 3 : t > lifeTicks - 6 ? (lifeTicks - t) / 6 : 1)",
      "style": {
        "fill": "--bubble",
        "fillOpacity": 0.6,
        "stroke": "--ink",
        "strokeWidth": 1.6,
        "highlight": {
          "offset": -0.35,
          "rScale": 0.3,
          "fill": "#ffffff"
        }
      },
      "sources": {
        "head": {
          "x": "24 + sin(t / 2.5 + i * 2) * 2.5",
          "y": "-62 + lift - t * 3.2"
        },
        "collar": {
          "x": "side * (47 + min(t, 6) * 0.5) + sin(t / 2.5 + i) * 2",
          "y": "-18 + lift - t * 4",
          "side": "i % 2 == 0 ? -1 : 1"
        }
      },
      "onWhen": ["pose:talk", "accessory:seaWalkHelmet"]
    }
  },
